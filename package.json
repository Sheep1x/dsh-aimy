{
  "name": "dsh-aimy",
  "version": "0.1.0",
  "description": "dsh-Aimy — 解决中转站多分组多倍率不方便管理的问题：提供分组接口的站点可就地切组并同步刷新模型与倍率，缺少该接口的站点自动降级为只读（兼容 new-api / sub2api）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.2 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0"
  },
  "peerDependenciesMeta": {},
  "displayName": "dsh-Aimy",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sheep1x/dsh-aimy.git"
  },
  "homepage": "https://github.com/Sheep1x/dsh-aimy",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "one-hub",
    "relay",
    "new-api",
    "sub2api"
  ],
  "icon": "assets/icon-180.png",
  "author": "Sheep1x"
}
