{
  "name": "dsh-aimy",
  "version": "0.1.0",
  "description": "dsh-Aimy — 用 Aimy 中转站的模型，并在设置页真实切换分组（兼容 new-api / sub2api）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  },
  "displayName": "dsh-Aimy",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sheep1x/dsh-aimy.git"
  },
  "homepage": "https://github.com/Sheep1x/dsh-aimy",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "one-hub",
    "relay",
    "new-api",
    "sub2api"
  ]
}
